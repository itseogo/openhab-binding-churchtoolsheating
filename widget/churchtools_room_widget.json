                                  color: var(--f7-text-color-secondary, #8e8e93)
                                  text-transform: uppercase
                                  font-weight: 600
                            - component: Label
                              config:
                                text: '=dayjs(items[(props.item_nextEvent3Start || (props.prefix + "_nextEvent3Start"))].state).format("DD")'

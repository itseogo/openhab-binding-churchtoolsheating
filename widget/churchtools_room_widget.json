component: f7-block
config:
  style:
    padding: 0
    margin: 0
    display: flex
    flex-direction: column
    gap: 15px
slots:
  default:
    - component: f7-card
      config:
        style:
          border-radius: 12px
          overflow: hidden
          margin: 0
      slots:
        default:
          - component: f7-card-content
            config:
              style:
                padding: 0
            slots:
              default:
                - component: f7-block
                  config:
                    style:
                      height: 200px
                      background-image: ="url(" + (props.backgroundImage || "https://images.unsplash.com/photo-1497366216548-37526070297c?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80") + ")"
                      background-size: cover
                      background-position: center
                      margin: 0
                - component: f7-row
                  config:
                    class: align-items-center
                    style:
                      padding: 15px
                      background: white
                  slots:
                    default:
                      - component: f7-col
                        config:
                          width: "15"
                        slots:
                          default:
                            - component: f7-icon
                              config:
                                f7: app_badge
                                color: blue
                                size: 28
                      - component: f7-col
                        config:
                          width: "85"
                        slots:
                          default:
                            - component: Label
                              config:
                                text: =props.title
                                style:
                                  font-weight: bold
                                  font-size: 16px
                                  color: black
                            - component: Label
                              config:
                                text: '=((items[(props.item_currentTemperature || (props.prefix + "_currentTemperature"))].state === "NULL" || items[(props.item_currentTemperature || (props.prefix + "_currentTemperature"))].state === "UNDEF") ? "-": (items[(props.item_currentTemperature || (props.prefix + "_currentTemperature"))].displayState || items[(props.item_currentTemperature || (props.prefix + "_currentTemperature"))].state)) + " · " + ((items[(props.item_Humidity || (props.prefix + "_Humidity"))].state === "NULL" || items[(props.item_Humidity || (props.prefix + "_Humidity"))].state === "UNDEF") ? "-": (items[(props.item_Humidity || (props.prefix + "_Humidity"))].displayState || items[(props.item_Humidity || (props.prefix + "_Humidity"))].state))'
                                style:
                                  font-size: 12px
                                  color: gray
    - component: f7-card
      config:
        style:
          border-radius: 12px
          margin: 0
          margin-bottom: 10px
          background-color: "#cce5ff"
          border: 1px solid #b8daff
        visible: '=items[(props.item_summerMode || (props.prefix + "_summerMode"))].state === "ON"'
      slots:
        default:
          - component: f7-row

                        slots:
                          default:
                            - component: Label
                              config:
                                text: '=(items[(props.item_upcomingEvent2 || (props.prefix + "_upcomingEvent2"))].state === "NULL" || items[(props.item_upcomingEvent2 || (props.prefix + "_upcomingEvent2"))].state === "UNDEF") ? "": items[(props.item_upcomingEvent2 || (props.prefix + "_upcomingEvent2"))].state'
                                style:

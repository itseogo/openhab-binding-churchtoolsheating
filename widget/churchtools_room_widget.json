uid: churchtools_room_widget
tags:
  - Churchtools
  - Heizung
  - Raum
props:
  parameters:
    - description: Das Item-Prefix für diesen Raum (z.B. Room_Saal)
      label: Raum Präfix
      name: prefix
      required: true
      type: TEXT
    - description: Titel des Raums über der Tabelle
      label: Raum Name
      name: title
      required: true
      type: TEXT
    - context: item
      description: Item für den Ventil Status (z.B. vom externen Aktor als Contact). Wenn leer, wird der Relais-Status genutzt.
      label: Ventil Status Item
      name: valveItem
      required: false
      type: TEXT
    - context: item
      description: Item für die Ventilöffnung in % (z.B. vom Heizungsaktor).
      label: Ventil Öffnung Item (%)
      name: valveOpeningItem
      required: false
      type: TEXT
    - context: item
      description: Item für den externen Aktor Basis-Sollwert (z.B. KNX).
      label: Aktor Soll-Temperatur Item
      name: knxTargetTempItem
      required: false
      type: TEXT
    - description: URL zum Hintergrundbild (z.B. /static/raum.jpg oder https://...)
      label: Hintergrundbild URL
      name: backgroundImage
      required: false
      type: TEXT
    - context: item
      description: Optional abweichendes Item für _HVAC_Mode. Bleibt es leer, wird 'Prefix_HVAC_Mode' genutzt.
      label: "Item: HVAC_Mode"
      name: item_HVAC_Mode
      required: false
      type: TEXT
    - context: item
      description: Optional abweichendes Item für _Humidity. Bleibt es leer, wird 'Prefix_Humidity' genutzt.
      label: "Item: Humidity"
      name: item_Humidity
      required: false
      type: TEXT
    - context: item
      description: Optional abweichendes Item für _Manual_Override_Until. Bleibt es leer, wird 'Prefix_Manual_Override_Until' genutzt.
      label: "Item: Manual_Override_Until"
      name: item_Manual_Override_Until
      required: false
      type: TEXT
    - context: item
      description: Optional abweichendes Item für _actualHeatingStart. Bleibt es leer, wird 'Prefix_actualHeatingStart' genutzt.
      label: "Item: actualHeatingStart"
      name: item_actualHeatingStart
      required: false
      type: TEXT
    - context: item
      description: Optional abweichendes Item für _currentTemperature. Bleibt es leer, wird 'Prefix_currentTemperature' genutzt.
      label: "Item: currentTemperature"
      name: item_currentTemperature
      required: false
      type: TEXT
    - context: item
      description: Optional abweichendes Item für _heatingEnabled. Bleibt es leer, wird 'Prefix_heatingEnabled' genutzt.
      label: "Item: heatingEnabled"
      name: item_heatingEnabled
      required: false
      type: TEXT
    - context: item
      description: Optional abweichendes Item für _heatingRelay. Bleibt es leer, wird 'Prefix_heatingRelay' genutzt.
      label: "Item: heatingRelay"
      name: item_heatingRelay
      required: false
      type: TEXT
    - context: item
      description: Optional abweichendes Item für _heatingStart. Bleibt es leer, wird 'Prefix_heatingStart' genutzt.
      label: "Item: heatingStart"
      name: item_heatingStart
      required: false
      type: TEXT
    - context: item
      description: Optional abweichendes Item für _nextEvent2End. Bleibt es leer, wird 'Prefix_nextEvent2End' genutzt.
      label: "Item: nextEvent2End"
      name: item_nextEvent2End
      required: false
      type: TEXT
    - context: item
      description: Optional abweichendes Item für _nextEvent2Start. Bleibt es leer, wird 'Prefix_nextEvent2Start' genutzt.
      label: "Item: nextEvent2Start"
      name: item_nextEvent2Start
      required: false
      type: TEXT
    - context: item
      description: Optional abweichendes Item für _nextEvent3End. Bleibt es leer, wird 'Prefix_nextEvent3End' genutzt.
      label: "Item: nextEvent3End"
      name: item_nextEvent3End
      required: false
      type: TEXT
    - context: item
      description: Optional abweichendes Item für _nextEvent3Start. Bleibt es leer, wird 'Prefix_nextEvent3Start' genutzt.
      label: "Item: nextEvent3Start"
      name: item_nextEvent3Start
      required: false
      type: TEXT
    - context: item
      description: Optional abweichendes Item für _nextEventEnd. Bleibt es leer, wird 'Prefix_nextEventEnd' genutzt.
      label: "Item: nextEventEnd"
      name: item_nextEventEnd
      required: false
      type: TEXT
    - context: item
      description: Optional abweichendes Item für _nextEventStart. Bleibt es leer, wird 'Prefix_nextEventStart' genutzt.
      label: "Item: nextEventStart"
      name: item_nextEventStart
      required: false
      type: TEXT
    - context: item
      description: Optional abweichendes Item für _summerMode. Bleibt es leer, wird 'Prefix_summerMode' genutzt.
      label: "Item: summerMode"
      name: item_summerMode
      required: false
      type: TEXT
    - context: item
      description: Optional abweichendes Item für _targetTemperature. Bleibt es leer, wird 'Prefix_targetTemperature' genutzt.
      label: "Item: targetTemperature"
      name: item_targetTemperature
      required: false
      type: TEXT
    - context: item
      description: Optional abweichendes Item für _upcomingEvent1. Bleibt es leer, wird 'Prefix_upcomingEvent1' genutzt.
      label: "Item: upcomingEvent1"
      name: item_upcomingEvent1
      required: false
      type: TEXT
    - context: item
      description: Optional abweichendes Item für _upcomingEvent2. Bleibt es leer, wird 'Prefix_upcomingEvent2' genutzt.
      label: "Item: upcomingEvent2"
      name: item_upcomingEvent2
      required: false
      type: TEXT
    - context: item
      description: Optional abweichendes Item für _upcomingEvent3. Bleibt es leer, wird 'Prefix_upcomingEvent3' genutzt.
      label: "Item: upcomingEvent3"
      name: item_upcomingEvent3
      required: false
      type: TEXT

                # Aktiver Heizstatus Banner
                - component: f7-block
                  config:
                    visible: '=items[(props.item_heatingRelay || (props.prefix + "_heatingRelay"))].state === "ON"'
                    style:
                      display: flex
                      align-items: center
                      gap: 12px
                      background: rgba(52, 199, 89, 0.16)
                      border-radius: 10px
                      padding: 10px 14px
                      margin-top: 6px
                  slots:
                    default:
                      - component: f7-icon

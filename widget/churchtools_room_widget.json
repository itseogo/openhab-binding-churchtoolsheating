                                  font-size: 14px
                                  color: var(--f7-text-color, #1c1c1e)
                                  white-space: normal
                                  word-break: break-word
                            - component: Label
                              config:
                                text: '=dayjs(items[(props.item_nextEvent2Start || (props.prefix + "_nextEvent2Start"))].state).format("HH:mm") + " - " + dayjs(items[(props.item_nextEvent2End || (props.prefix + "_nextEvent2End"))].state).format("HH:mm") + " Uhr"'
                                style:
                                  font-size: 12px
                                  color: var(--f7-text-color-secondary, #8e8e93)
                                  margin-top: 2px

                # Termin 3
                - component: f7-block
                  config:
                    visible: '=(items[(props.item_nextEvent3Start || (props.prefix + "_nextEvent3Start"))].state !== "NULL" && items[(props.item_nextEvent3Start || (props.prefix + "_nextEvent3Start"))].state !== "UNDEF" && items[(props.item_nextEvent3Start || (props.prefix + "_nextEvent3Start"))].state !== "-")'
                    style:
                      display: flex
                      align-items: center
                      gap: 14px
                      margin: 0
                      padding-top: 10px
                      border-top: 1px solid rgba(128, 128, 128, 0.15)
                  slots:
                    default:
                      - component: f7-block
                        config:
                          style:
                            width: 48px
                            min-width: 48px
                            text-align: center
                            background: rgba(120, 120, 128, 0.16)
                            border-radius: 10px
                            padding: 5px 0

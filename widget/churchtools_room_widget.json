                                style:
                                  font-size: 12px
                                  color: var(--f7-text-color-secondary, #8e8e93)
                                  margin-top: 2px

                # Termin 2
                - component: f7-block
                  config:
                    visible: '=(items[(props.item_nextEvent2Start || (props.prefix + "_nextEvent2Start"))].state !== "NULL" && items[(props.item_nextEvent2Start || (props.prefix + "_nextEvent2Start"))].state !== "UNDEF" && items[(props.item_nextEvent2Start || (props.prefix + "_nextEvent2Start"))].state !== "-")'
                    style:
